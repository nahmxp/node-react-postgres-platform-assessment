# Copy to .env (git-ignored) and change the values:  cp .env.example .env
# docker compose reads .env automatically.

# --- PostgreSQL ---
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=appdb
DB_PORT=5432

# --- Backend ---
BACKEND_PORT=4000

# --- Frontend ---
FRONTEND_PORT=8080
# Baked into the React bundle at build time. "/api" = same-origin through the
# frontend nginx proxy (recommended). Set to http://localhost:4000/api to have
# the browser call the backend directly instead.
VITE_API_BASE_URL=/api
